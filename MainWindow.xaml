<Window x:Class="SecureWindowApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Veyra" Icon="Assets/VeyraIcon.png" Height="780" Width="1200"
        MinHeight="540" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#F7F8FC" ShowInTaskbar="True" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="ShellView" Grid.RowSpan="3"/>
        <Grid x:Name="BrowserContentHost" Grid.Row="2" ClipToBounds="True"/>
        <TextBlock x:Name="ShellStartupError" Grid.Row="2" Margin="32" TextWrapping="Wrap" Visibility="Collapsed"/>
        <!-- Temporary compatibility state for the existing browser/session/security controller.
             Only ui/ renders visible controls; these are never part of the focus order. -->
        <StackPanel Visibility="Collapsed">
            <ListBox x:Name="BrowserTabStrip" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tabs}"
                     SelectionChanged="BrowserTabStrip_SelectionChanged"/>
            <Button x:Name="NewTabButton"/><Button x:Name="BackButton"/><Button x:Name="ForwardButton"/>
            <Button x:Name="ReloadButton"/><Button x:Name="StopButton"/><Button x:Name="HomeButton"/>
            <Button x:Name="SettingsButton"/><Button x:Name="MuteButton"/>
            <TextBox x:Name="AddressBox"/><TextBox x:Name="StartPageSearchBox"/>
            <Ellipse x:Name="ProtectionIndicator"/>
            <Border x:Name="NewTabPage"/><Border x:Name="SettingsPanel"/>
            <CheckBox x:Name="ProtectionCheckBox"/><TextBlock x:Name="ZoomText"/>
            <TextBlock x:Name="SettingsMessage"/><TextBlock x:Name="ErrorText" Visibility="Collapsed"/>
            <ComboBox x:Name="FavoritesBox" DisplayMemberPath="Title" SelectionChanged="FavoritesBox_SelectionChanged"/>
        </StackPanel>
    </Grid>
</Window>
