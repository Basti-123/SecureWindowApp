<Window x:Class="SecureWindowApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sicheres Fenster"
        Height="720" Width="1100"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F8"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#1A73E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#202124"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#5F6368"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AECBFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D2E3FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserTabItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Background" Value="#E8EAED"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MaxWidth" Value="250"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F3F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Browser-Tab-Leiste wie bei einem modernen Browser -->
        <Border Grid.Row="0"
                Background="#E8EAED"
                CornerRadius="10,10,0,0"
                Padding="6,6,6,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="NewTabButton"
                        DockPanel.Dock="Right"
                        Width="32"
                        Height="32"
                        Content="+"
                        FontSize="20"
                        Foreground="{StaticResource SubTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Neuen Tab öffnen"
                        Click="NewTabButton_Click"/>
                <ListBox x:Name="BrowserTabStrip"
                         ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Tabs}"
                         SelectionChanged="BrowserTabStrip_SelectionChanged"
                         ItemContainerStyle="{StaticResource BrowserTabItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,24,0"/>
                                <Button Content="×"
                                        Tag="{Binding}"
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        FontSize="15"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="Tab schließen"
                                        Click="CloseTabButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Browser-Navigation und Adresszeile -->
        <Grid Grid.Row="1" Background="#F4F5F8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Style="{StaticResource NavButton}"
                    Content="&#xE72B;" ToolTip="Zurück"
                    IsEnabled="False"
                    Click="BackButton_Click"/>
            <Button x:Name="ForwardButton" Grid.Column="1"
                    Style="{StaticResource NavButton}"
                    Content="&#xE72A;" ToolTip="Vor"
                    IsEnabled="False"
                    Click="ForwardButton_Click"/>
            <Button x:Name="ReloadButton" Grid.Column="2"
                    Style="{StaticResource NavButton}"
                    Content="&#xE72C;" ToolTip="Neu laden"
                    Click="ReloadButton_Click"/>
            <Button x:Name="StopButton" Grid.Column="3"
                    Style="{StaticResource NavButton}"
                    Content="&#xE71A;" ToolTip="Laden abbrechen"
                    IsEnabled="False"
                    Click="StopButton_Click"/>
            <Button x:Name="HomeButton" Grid.Column="4"
                    Style="{StaticResource NavButton}"
                    Content="&#xE80F;" ToolTip="Startseite"
                    Click="HomeButton_Click"/>
            <Button x:Name="SettingsButton" Grid.Column="5"
                    Style="{StaticResource NavButton}"
                    Content="&#xE713;" ToolTip="Einstellungen"
                    Click="SettingsButton_Click"/>
            <Button x:Name="MuteButton" Grid.Column="6"
                    Style="{StaticResource NavButton}"
                    FontFamily="Segoe UI Emoji"
                    Content="🔊" ToolTip="Ton stummschalten"
                    IsEnabled="False"
                    Click="MuteButton_Click"/>

            <Border Grid.Column="7"
                    Background="#FFFFFF"
                    BorderBrush="#DADCE0"
                    BorderThickness="1"
                    CornerRadius="9"
                    Height="34">
                <Grid>
                    <TextBox x:Name="AddressBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             FontSize="13"
                             Padding="12,0,36,0"
                             VerticalContentAlignment="Center"
                             KeyDown="AddressBox_KeyDown"/>
                    <Ellipse x:Name="ProtectionIndicator"
                             Width="10"
                             Height="10"
                             Fill="#A6E3A1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,13,0"
                             ToolTip="Aufnahmeschutz aktiv"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Seiteninhalt, Fehlermeldung und Einstellungen -->
        <Grid Grid.Row="2">
            <Border Background="#FFFFFF"
                    BorderBrush="#DADCE0"
                    BorderThickness="1"
                    CornerRadius="0,0,10,10"/>
            <ContentControl x:Name="BrowserContentHost"/>
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="24"
                       VerticalAlignment="Center"/>
            <Border x:Name="SettingsPanel"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#DADCE0"
                    BorderThickness="1"
                    CornerRadius="0,0,10,10"
                    Padding="24">
                <StackPanel VerticalAlignment="Top" MaxWidth="560">
                    <TextBlock Text="Einstellungen"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>
                    <CheckBox x:Name="ProtectionCheckBox"
                              Content="Aufnahmeschutz aktiv"
                              IsChecked="True"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="14"
                              Click="ProtectionCheckBox_Click"/>
                    <TextBlock Text="Beim Start ist der Schutz automatisch aktiv. Änderungen sind nur hier möglich; globale Hotkeys wurden deaktiviert."
                               Foreground="{StaticResource SubTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>

                    <Separator Margin="0,22,0,14"/>
                    <TextBlock Text="Browser" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Width="36" Height="30" Content="−" ToolTip="Zoom verkleinern" Click="ZoomOutButton_Click"/>
                        <TextBlock x:Name="ZoomText" Text="100 %" Width="64" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        <Button Width="36" Height="30" Content="+" ToolTip="Zoom vergrößern" Click="ZoomInButton_Click"/>
                        <Button Width="70" Height="30" Content="100 %" Margin="12,0,0,0" Click="ZoomResetButton_Click"/>
                    </StackPanel>

                    <Button Content="Browserdaten löschen" Margin="0,16,0,0" Padding="10,6" HorizontalAlignment="Left" Click="ClearBrowsingDataButton_Click"/>
                    <TextBlock x:Name="SettingsMessage"
                               Foreground="{StaticResource SubTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                    <TextBlock Text="Favoriten" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,0"/>
                    <ComboBox x:Name="FavoritesBox"
                              DisplayMemberPath="Title"
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,10,0,0"
                              SelectionChanged="FavoritesBox_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Aktuelle Seite speichern" Padding="10,6" Click="AddFavoriteButton_Click"/>
                        <Button Content="Entfernen" Padding="10,6" Margin="8,0,0,0" Click="RemoveFavoriteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
