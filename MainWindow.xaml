<Window x:Class="SecureWindowApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicheres Fenster"
        Height="320" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#89B4FA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#313244"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Statusanzeige -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="12" Height="12"
                         Fill="#A6E3A1"
                         Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Geschützt vor Bildschirmaufnahmen"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Dieses Fenster wird über SetWindowDisplayAffinity (WDA_EXCLUDEFROMCAPTURE) von Screenshots, Screen-Recording und Screen-Sharing ausgeschlossen."
                   Foreground="{StaticResource SubTextBrush}"
                   FontSize="12.5"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Beispielinhalt -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                CornerRadius="10"
                Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vertraulicher Inhalt"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Alles, was hier angezeigt wird, bleibt bei aktivem Schutz für Aufnahme-Tools unsichtbar."
                           Foreground="{StaticResource SubTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="OsInfoText"
                   Text=""
                   Foreground="{StaticResource SubTextBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0"/>
    </Grid>
</Window>
