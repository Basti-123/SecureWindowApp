<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Erlaubt Cross-Compilation auf macOS/Linux; unter Windows ohne Effekt. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- WinForms wird nur fuer das Tray-Symbol (NotifyIcon) benoetigt -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SecureWindowApp</AssemblyName>
    <RootNamespace>SecureWindowApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0</InformationalVersion>

    <!-- Self-Contained Single-File Konfiguration -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Optional: kleinere Dateigröße, schnellerer Start -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Eingebetteter Browser (Edge/Chromium) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

</Project>
