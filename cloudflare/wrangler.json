{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "veyra-website",
  "account_id": "8c2620247f8c9009745cd2d9408770a9",
  "main": "../worker/cloudflare.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/downloads/*.zip", "/analytics", "/api/*"]
  },
  "vars": {
    "GITHUB_RELEASE_BASE": "https://github.com/Basti-123/SecureWindowApp/releases/download"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veyra-analytics",
      "database_id": "5874070d-fa93-4288-bbfc-f15e1b0bef08"
    }
  ]
}
