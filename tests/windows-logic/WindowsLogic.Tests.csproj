<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SessionStore.cs" Link="SessionStore.cs" />
    <Compile Include="../../WebViewFailurePolicy.cs" Link="WebViewFailurePolicy.cs" />
    <Compile Include="../../PortableWebViewRuntime.cs" Link="PortableWebViewRuntime.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" ExcludeAssets="all" GeneratePathProperty="true" />
    <!-- These tests use Core enums, without importing WPF/WinForms targets. -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
